# Bookstride server configuration.
#
# Copy to ~/.config/bookstride/env and edit. Read by the bookstride
# systemd user service via EnvironmentFile=.
#
# systemd EnvironmentFile syntax: KEY=VALUE, no quotes, no spaces around
# '=', '#' starts a comment. There are NO secrets here — the server
# forwards each user's libro.fm credentials per request and stores none.

# Interface for Rocket to bind. Keep 127.0.0.1 so only the local nginx
# reverse proxy can reach the app; nginx terminates TLS on 443 and
# forwards here. Rocket's default is already 127.0.0.1 — set explicitly
# so it can't drift if a future Rocket changes the default. The listen
# PORT is fixed at 8000 by the app itself and is not configurable here.
ROCKET_ADDRESS=127.0.0.1

# Rocket log level: off | critical | normal | debug.
# `normal` shows request logs plus the app's own info!/warn!/error!
# lines — libro.fm retries, rate-limit waits, download
# completion/failure, and GoatCounter analytics. Drop to `critical`
# for a quieter log.
ROCKET_LOG_LEVEL=normal

# GoatCounter API key for server-side analytics (optional). When set,
# the server sends event hits to bookstride.goatcounter.com on login
# success, library list, download start, and download complete. When
# absent, no server-side analytics are sent.
#
# Generate a key at https://bookstride.goatcounter.com under your
# account menu → API.
#
#GOATCOUNTER_API_KEY=

# Maximum size of the on-disk media cache (~/bookstride-cache) before
# the server starts evicting. When the total size of cached
# bookstride_cache_*.mp3 files exceeds this, the download worker
# deletes the 10 oldest files before fetching new ones. Accepts a bare
# byte count or a number with a unit suffix: K/KB, M/MB, G/GB, T/TB
# (binary multiples, case-insensitive). Default: 3GB.
#MAX_MEDIA_SIZE=3GB
